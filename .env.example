# VehicleGPT Environment Configuration
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=data/vehiclegpt.db

# Offline Local SLM Configuration (Optional)
# Supported SLMs: qwen2.5:1.5b, llama3.2:1b, phi3:mini, mistral:7b
USE_LOCAL_LLM=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
LLM_TIMEOUT_SECONDS=6.0
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000

# Anomaly Thresholds
BATTERY_TEMP_ALERT_THRESHOLD=45.0
ENERGY_CONSUMPTION_HIGH_THRESHOLD=25.0
RANDOM_SEED=42
